# 统一换行符为 LF，避免 Windows 与 Linux 云服务器之间出现"整个文件都变了"的假 diff
* text=auto eol=lf

# Windows 批处理脚本必须用 CRLF，否则 cmd 解析会出错
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件不做任何换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.safetensors binary
*.bin binary
*.pt binary
*.pth binary
*.gguf binary
